@startuml class-diagram
!pragma layout smetana
title LMS - Class Diagram overview (members hidden; see the three detailed views)
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FBFCFF
  BorderColor #1F3864
}
left to right direction
hide empty members
hide members
hide enum members


package "domain" {
  enum Role {
    Administrator
    Lecturer
    HeadOfDepartment
    Student
  }
  enum Permission {
    ManageUsers
    ManageDepartments
    ManageCourses
    AssignLecturers
    EnrolStudents
    CreateAssignment
    GrantExtension
    MarkSubmission
    SubmitWork
    ViewReleasedResults
    ModerateMarks
    ReleaseMarks
    ViewAuditLog
  }

  abstract class User {
    - id_ : int
    - username_ : string
    - fullName_ : string
    - departmentId_ : optional<int>
    # User(id : int, username : string, fullName : string, departmentId : optional<int>)
    + id() : int
    + username() : const string&
    + fullName() : const string&
    + departmentId() : optional<int>
    + {abstract} role() : Role
    + {abstract} roleTitle() : string
    + can(p : Permission) : bool
    + require(p : Permission) : void
    + {abstract} hasDepartmentScope(departmentId : int) : bool
    # {abstract} permissions() : const set<Permission>&
  }
  class Administrator
  class Lecturer
  class HeadOfDepartment
  class Student

  User <|-- Administrator
  User <|-- Lecturer
  User <|-- HeadOfDepartment
  User <|-- Student
  User ..> Role
  User ..> Permission

  class UserRecord <<struct>> {
    + id : int
    + username : string
    + passwordHash : string
    + fullName : string
    + role : Role
    + departmentId : optional<int>
    + active : bool
    + failedLoginAttempts : int
    + lockedUntil : Timestamp
    + createdAt : Timestamp
  }

  class UserFactory <<Factory>> {
    + {static} create(record : const UserRecord&) : unique_ptr<User>
  }
  UserFactory ..> UserRecord
  UserFactory ..> User : <<creates>>

  class Department <<struct>> {
    + id : int
    + name : string
  }
  class Course <<struct>> {
    + id : int
    + code : string
    + title : string
    + departmentId : int
  }
  class Assignment <<struct>> {
    + id : int
    + courseId : int
    + title : string
    + description : string
    + deadline : Timestamp
    + maxMark : int
    + createdBy : int
    + createdAt : Timestamp
  }
  class ClassExtension <<struct>> {
  }
  class Extension <<struct>> {
    + id : int
    + assignmentId : int
    + studentId : int
    + newDeadline : Timestamp
    + reason : string
    + grantedBy : int
    + grantedAt : Timestamp
  }
  enum SubmissionStatus {
    Submitted
    Late
    Marked
    Moderated
    Released
  }
  class Submission <<struct>> {
    + id : int
    + assignmentId : int
    + studentId : int
    + content : string
    + submittedAt : Timestamp
    + version : int
    + status : SubmissionStatus
    + rawMark : optional<double>
    + daysLate : int
    + lateDeduction : double
    + finalMark : optional<double>
    + feedback : string
    + markedBy / moderatedBy / releasedBy : optional<int>
    + markedAt / moderatedAt / releasedAt : optional<Timestamp>
  }
  class SubmissionLifecycle {
    + {static} canTransition(from : SubmissionStatus, to : SubmissionStatus) : bool
    + {static} requireTransition(from : SubmissionStatus, to : SubmissionStatus) : void
    + {static} isMarkable(s : SubmissionStatus) : bool
    + {static} isVisibleToStudent(s : SubmissionStatus) : bool
  }
  class MarkAuditEntry <<struct>> {
    + id : int
    + submissionId : int
    + changedBy : int
    + changedAt : Timestamp
    + action : AuditAction
    + oldMark : optional<double>
    + newMark : optional<double>
    + reason : string
  }
  class Notification <<struct>> {
    + id : int
    + userId : int
    + message : string
    + createdAt : Timestamp
    + read : bool
  }

  Department "1" -- "0..*" Course
  Course "1" -- "0..*" Assignment
  Assignment "1" -- "0..*" Extension
  Assignment "1" -- "0..1" ClassExtension
  Assignment "1" -- "0..*" Submission
  Submission "1" *-- "1..*" MarkAuditEntry : audit trail >
  Submission --> SubmissionStatus
  SubmissionLifecycle ..> SubmissionStatus
}

package "policy  <<Strategy>>" {
  interface ILatePenaltyPolicy {
    + {abstract} apply(rawMark : double, maxMark : int, daysLate : int) : PenaltyResult
    + {abstract} description() : string
  }
  class PercentPerDayPenaltyPolicy {
    - percentPerDay_ : double
    - maxPenalisedDays_ : int
    + PercentPerDayPenaltyPolicy(percentPerDay : double = 10, maxPenalisedDays : int = 3)
    + apply(rawMark : double, maxMark : int, daysLate : int) : PenaltyResult
    + description() : string
  }
  class NoLatePenaltyPolicy {
    + apply(rawMark : double, maxMark : int, daysLate : int) : PenaltyResult
    + description() : string
  }
  class PenaltyResult <<struct>> {
    + rawMark : double
    + daysLate : int
    + deduction : double
    + finalMark : double
    + explanation : string
  }
  class LatenessCalculator {
    + {static} daysLate(submittedAt : Timestamp, effectiveDeadline : Timestamp) : int
  }
  ILatePenaltyPolicy <|.. PercentPerDayPenaltyPolicy
  ILatePenaltyPolicy <|.. NoLatePenaltyPolicy
  ILatePenaltyPolicy ..> PenaltyResult
}

package "events  <<Observer>>" {
  interface ISubmissionObserver {
    + {abstract} onSubmissionEvent(event : const SubmissionEvent&) : void
  }
  class SubmissionEventPublisher {
    - observers_ : vector<ISubmissionObserver*>
    + subscribe(o : ISubmissionObserver&) : void
    + unsubscribe(o : ISubmissionObserver&) : void
    + publish(event : const SubmissionEvent&) : void
  }
  SubmissionEventPublisher o-- "0..*" ISubmissionObserver
}

package "security" {
  interface IPasswordHasher {
    + {abstract} hash(password : string) : string
    + {abstract} verify(password : string, encodedHash : string) : bool
  }
  class Argon2idPasswordHasher {
    - params_ : Argon2Params
    + hash(password : string) : string
    + verify(password : string, encodedHash : string) : bool
  }
  class PasswordPolicy {
    + {static} validate(password : string, username : string) : void
  }
  IPasswordHasher <|.. Argon2idPasswordHasher
}

package "data  <<Repository / DAO>>" {
  interface IUserRepository {
    + add(u : const UserRecord&) : int
    + update(u : const UserRecord&) : void
    + findById(id : int) : optional<UserRecord>
    + findByUsername(name : string) : optional<UserRecord>
    + findHeadOfDepartment(departmentId : int) : optional<UserRecord>
    + listByRole(r : Role) : vector<UserRecord>
    + countByRole(r : Role) : int
  }
  interface ICourseRepository
  interface IAssignmentRepository {
    + add(a : const Assignment&) : int
    + findById(id : int) : optional<Assignment>
    + listByCourse(courseId : int) : vector<Assignment>
    + saveExtension(e : const Extension&) : void
    + findExtension(assignmentId : int, studentId : int) : optional<Extension>
  }
  interface ISubmissionRepository {
    + add(s : const Submission&) : int
    + update(s : const Submission&) : void
    + find(assignmentId : int, studentId : int) : optional<Submission>
    + listByDepartmentAndStatus(dept : int, s : SubmissionStatus) : vector<Submission>
    + addVersion(id : int, version : int, content : string, at : Timestamp) : void
  }
  interface IAuditRepository {
    + add(e : const MarkAuditEntry&) : int
    + listForSubmission(id : int) : vector<MarkAuditEntry>
  }
  interface IDepartmentRepository
  interface INotificationRepository
  interface ITransactionRunner {
    + run(work : function<void()>) : void
  }
  class SqliteUserRepository
  class SqliteSubmissionRepository
  class "Sqlite*Repository (5 more)" as SqliteOthers
  class Database {
    - db_ : sqlite3*
    + prepare(sql : string) : Statement
    + execute(sql : string) : void
    + inTransaction(work : function<void()>) : void
  }
  IUserRepository <|.. SqliteUserRepository
  ISubmissionRepository <|.. SqliteSubmissionRepository
  IAssignmentRepository <|.. SqliteOthers
  ICourseRepository <|.. SqliteOthers
  IAuditRepository <|.. SqliteOthers
  SqliteUserRepository --> Database
  SqliteSubmissionRepository --> Database
  SqliteOthers --> Database
}

package "services" {
  class AuthService {
    + {static} kMaxFailedAttempts : int = 5
    + login(username : string, password : string) : unique_ptr<User>
    + changePassword(actor : const User&, current : string, next : string) : void
  }
  class AdminService {
    + createUser(actor : const User&, role : Role, username : string, fullName : string, password : string, dept : optional<int>) : int
    + setActive(actor : const User&, userId : int, active : bool) : void
    + createDepartment(actor : const User&, name : string) : int
    + createCourse(actor : const User&, code : string, title : string, dept : int) : int
    + assignLecturer(actor : const User&, courseId : int, lecturerId : int) : void
    + enrolStudent(actor : const User&, courseId : int, studentId : int) : void
  }
  class AssignmentService {
    + createAssignment(actor : const User&, courseId : int, title : string, description : string, deadline : Timestamp, maxMark : int) : int
    + grantExtension(actor : const User&, assignmentId : int, studentId : int, newDeadline : Timestamp, reason : string) : void
    + effectiveDeadline(a : const Assignment&, studentId : int) : Timestamp
    + listForStudent(student : const User&) : vector<StudentAssignmentView>
  }
  class SubmissionService {
    + submit(actor : const User&, assignmentId : int, content : string) : SubmitResult
    + resultsFor(student : const User&) : vector<StudentResultView>
  }
  class MarkingService {
    + mark(actor : const User&, submissionId : int, rawMark : double, feedback : string, reason : string) : PenaltyResult
    + listForAssignment(actor : const User&, assignmentId : int) : vector<MarkingItem>
  }
  class ModerationService {
    + pendingModeration(hod : const User&) : vector<ModerationItem>
    + approve(hod : const User&, submissionId : int, note : string) : void
    + adjust(hod : const User&, submissionId : int, newFinalMark : double, reason : string) : void
    + releaseAssignment(hod : const User&, assignmentId : int) : ReleaseSummary
    + auditTrail(actor : const User&, submissionId : int) : vector<MarkAuditEntry>
  }
  class NotificationService {
    + onSubmissionEvent(event : const SubmissionEvent&) : void
    + unreadFor(user : const User&) : vector<Notification>
  }
  class LmsSystem <<composition root>> {
    + {static} createDefault(databasePath : string) : unique_ptr<LmsSystem>
  }

  ISubmissionObserver <|.. NotificationService
  AuthService --> IUserRepository
  AuthService --> IPasswordHasher
  AuthService ..> UserFactory
  AdminService --> IPasswordHasher
  SubmissionService --> AssignmentService
  MarkingService --> AssignmentService
  MarkingService --> "1" ILatePenaltyPolicy : penaltyPolicy_
  MarkingService ..> LatenessCalculator
  SubmissionService --> SubmissionEventPublisher
  MarkingService --> SubmissionEventPublisher
  ModerationService --> SubmissionEventPublisher
  AssignmentService --> SubmissionEventPublisher
  SubmissionService --> ISubmissionRepository
  MarkingService --> IAuditRepository
  ModerationService --> IAuditRepository
  MarkingService --> ITransactionRunner
  ModerationService --> ITransactionRunner
  SubmissionService ..> SubmissionLifecycle
  MarkingService ..> SubmissionLifecycle
  ModerationService ..> SubmissionLifecycle
  LmsSystem *-- "1" AuthService
  LmsSystem *-- "1" AdminService
  LmsSystem *-- "1" AssignmentService
  LmsSystem *-- "1" SubmissionService
  LmsSystem *-- "1" MarkingService
  LmsSystem *-- "1" ModerationService
  LmsSystem *-- "1" NotificationService
  LmsSystem *-- "1" Database
}
@enduml
