@startuml use-case
!pragma layout smetana
title Moderated LMS - Use Case Diagram (v1.1)
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFF
  BorderColor #1F3864
}

actor "User" as User <<abstract>>
actor "Student" as Student
actor "Lecturer" as Lecturer
actor "Head of\nDepartment" as HoD
actor "Administrator" as Admin

User <|-- Student
User <|-- Lecturer
User <|-- HoD
User <|-- Admin

rectangle "Moderated Learning Management System" {
  usecase "UC-13 Log in" as UC13
  usecase "UC-14 Change password" as UC14
  usecase "UC-15 View notifications" as UC15

  usecase "UC-07 View courses\nand assignments" as UC07
  usecase "UC-01 Submit assignment" as UC01
  usecase "Resubmit assignment" as UC01R
  usecase "Record late submission" as UC01L
  usecase "UC-06 View results\nand feedback" as UC06
  usecase "Determine effective\ndeadline" as DEAD

  usecase "UC-05 Create assignment" as UC05
  usecase "UC-04 Grant individual\nextension" as UC04
  usecase "UC-16 Grant class-wide\nextension (v1.1)" as UC16
  usecase "UC-02 Mark submission" as UC02
  usecase "Re-mark submission" as UC02R
  usecase "Apply late penalty" as PEN
  usecase "Record mark audit entry" as AUD

  usecase "UC-03 Moderate and\nrelease marks" as UC03
  usecase "Adjust mark" as UC03A
  usecase "UC-12 View mark\naudit log" as UC12

  usecase "UC-08 Manage user\naccounts" as UC08
  usecase "UC-09 Manage\ndepartments" as UC09
  usecase "UC-10 Manage courses and\nassign lecturers" as UC10
  usecase "UC-11 Enrol students" as UC11
}

User --> UC13
User --> UC14
User --> UC15

Student --> UC07
Student --> UC01
Student --> UC06

Lecturer --> UC05
Lecturer --> UC04
Lecturer --> UC16
UC16 ..> DEAD : <<include>>
Lecturer --> UC02

HoD --> UC03
HoD --> UC12

Admin --> UC08
Admin --> UC09
Admin --> UC10
Admin --> UC11
Admin --> UC12

UC01 ..> DEAD : <<include>>
UC07 ..> DEAD : <<include>>
UC01R ..> UC01 : <<extend>>\n[submission exists and\nnow <= effective deadline]
UC01L ..> UC01 : <<extend>>\n[now > effective deadline]

UC02 ..> PEN : <<include>>
UC02 ..> AUD : <<include>>
PEN ..> DEAD : <<include>>
UC02R ..> UC02 : <<extend>>\n[already marked]

UC03 ..> AUD : <<include>>
UC03A ..> UC03 : <<extend>>\n[HoD disagrees with mark]

note right of UC01
  Fully dressed:
  docs/04-requirements/use-cases.md
end note
@enduml
